# A token to increase the rate limiting from 60/hr to 1000/hr. Required in production.
GITHUB_TOKEN=""

# GitHub repo to pull docs from
SOURCE_REPO="boomerang-io/docs"

# For development, reading the docs from a local repo (the "local" version in the switcher)
LOCAL_REPO_RELATIVE_PATH="../docs"

# true/1/yes/on turns the in-memory caches off. Leave unset to keep caching on.
# NO_CACHE=true
